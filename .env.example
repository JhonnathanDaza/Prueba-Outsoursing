# Correo Gmail (contraseña de aplicación de 16 letras: https://myaccount.google.com/apppasswords)
EMAIL_USUARIO=tu_correo@gmail.com
EMAIL_CLAVE_APP=
# A quién se envía el Excel (vacío = a ti mismo)
CORREO_DESTINO=
# Remitente del correo de la prueba (vacío = cualquier correo con asunto "PRUEBA")
CORREO_REMITENTE=
# Respaldo si no hay correo
NIT=900156264
# Opcional: resolver el captcha automáticamente con 2Captcha
TWOCAPTCHA_API_KEY=
# uc = Chrome con SeleniumBase en modo UC (recomendado, evita el error 600010 de Cloudflare)
# normal = Edge/Chrome normal conectado a Selenium; selenium = navegador lanzado por Selenium
MODO_NAVEGADOR=uc
# Navegador para los modos normal y selenium: edge o chrome (el modo uc siempre usa Chrome)
NAVEGADOR=edge
# Ruta de msedge.exe o chrome.exe si no se encuentra sola (ej. C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe)
NAVEGADOR_RUTA=
PUERTO_DEPURACION=9222
# Modos normal/selenium: si = marca la casilla con JavaScript antes de hacer clic; no = solo clic
CASILLA_JS=si
# Extracción de las facturas: auto (capa de texto, OCR si el PDF es imagen) | texto | ocr
EXTRACCION=auto
# Ruta de tesseract.exe para el OCR (vacío = se busca solo)
TESSERACT_RUTA=
